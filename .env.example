# 沙漠掘金 · 沙盘运行参数（复制为 .env 后按需修改；docker compose 会读取同目录 .env）
PORT=3000
TZ=Asia/Shanghai
DATA_DIR=./data

# 管理员账号：仅在数据库里还没有管理员时用于首次初始化
ADMIN_USER=A
ADMIN_PASS=Aa0123456789

# 演示队伍 team01…team08 的初始密码；留空则不创建演示队伍
DEMO_PLAYER_PASS=desert888

# 固定 JWT 密钥（>=32 位随机串）。留空则自动生成到 ${DATA_DIR}/.jwt-secret
JWT_SECRET=

# 部署在 HTTPS（Nginx/Caddy 反代）后设为 true
HTTPS=false
